<section class="w-full py-10 px-5 bg-[#FDFBF7]" id="catalogo"
  data-filter-mode="{{ section.settings.filter_mode }}"
  data-filter-exclude="{{ section.settings.filter_exclude | escape }}"
  data-per-page="{{ section.settings.per_page }}">
<div class="max-w-[1320px] mx-auto flex flex-col gap-6">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <span class="text-[11px] text-[#E87373] uppercase tracking-widest font-bold">{{ section.settings.eyebrow }}</span>
      <h1 class="text-[24px] md:text-[32px] leading-10 text-[#5C4033] font-extrabold">{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="text-sm text-[#5C4033]/80 max-w-2xl font-medium">{{ collection.description }}</div>{% endif %}
    </div>
    <div class="flex items-center gap-2">
      <span class="text-xs text-[#5C4033] font-semibold" id="results-count">Cargando…</span>
      <div class="hidden sm:flex items-center bg-white border border-[#F0E7DE] rounded-full p-1">
        <button class="px-2.5 py-1 rounded-full text-[#5C4033] bg-[#FFF3CD] font-bold flex items-center" id="view-4-col" onclick="setColumns(4)" title="4 columnas" type="button"><span class="material-symbols-outlined text-[18px]">grid_view</span></button>
        <button class="px-2.5 py-1 rounded-full text-[#7A736E] font-bold flex items-center" id="view-5-col" onclick="setColumns(5)" title="5 columnas" type="button"><span class="material-symbols-outlined text-[18px]">view_comfy</span></button>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-2xl p-4 shadow-sm border border-[#F0E7DE] flex flex-col gap-4">
    <div class="flex items-center gap-2 overflow-x-auto pb-1 whitespace-nowrap" id="filter-chips"></div>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 items-center pt-2">
      <div class="flex items-center bg-[#FDFBF7] border border-[#F0E7DE] rounded-full px-4 py-2">
        <span class="material-symbols-outlined text-[#7A736E] mr-2 text-[18px]">search</span>
        <input class="w-full bg-transparent border-none outline-none text-sm" id="product-search" oninput="handleSearch(this.value)" placeholder="Buscar por producto…" type="text"/>
      </div>
      <div class="relative">
        <select class="w-full bg-[#FDFBF7] border border-[#F0E7DE] appearance-none rounded-full px-4 py-2.5 text-xs text-[#5C4033] font-semibold outline-none cursor-pointer" id="sort-select" onchange="sortProducts(this.value)">
          <option value="featured">Ordenar: Destacados</option>
          <option value="price-asc">Precio: Menor a Mayor</option>
          <option value="price-desc">Precio: Mayor a Menor</option>
          <option value="alpha">Nombre: A - Z</option>
        </select>
        <span class="material-symbols-outlined absolute right-3 top-3 text-[18px] pointer-events-none">expand_more</span>
      </div>
      <div class="flex flex-col px-1">
        <div class="flex justify-between items-center text-[11px] text-[#5C4033] mb-1"><span class="font-semibold">Precio máx:</span><span class="font-extrabold text-[#E87373]" id="price-val">…</span></div>
        <input class="cursor-pointer w-full" id="price-range" max="30000" min="0" oninput="filterByPrice(this.value)" step="500" type="range" value="30000"/>
      </div>
      <div class="flex items-center justify-start sm:justify-end">
        <label class="flex items-center cursor-pointer gap-2 select-none">
          <input class="sr-only peer" id="stock-toggle" onchange="toggleStockOnly(this.checked)" type="checkbox"/>
          <span class="w-9 h-5 rounded-full bg-[#F0E7DE] relative inline-block after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[#8DE4C5] peer-checked:after:translate-x-full"></span>
          <span class="text-[11px] font-semibold">Ocultar agotados</span>
        </label>
      </div>
    </div>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="product-grid"></div>
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-[#F0E7DE]">
    <p class="text-sm text-[#5C4033] font-medium" id="page-info"></p>
    <div class="flex flex-wrap items-center justify-center gap-1" id="pagination-bar"></div>
  </div>
</div>
</section>
<script>
const LACHOLI_PRODUCTS = [{% for p in collection.products %}{"id":{{ p.id }},"v":{{ p.selected_or_first_available_variant.id }},"t":{{ p.title | json }},"h":{{ p.handle | json }},"p":{{ p.price | divided_by: 100 }},"c":{% if p.compare_at_price %}{{ p.compare_at_price | divided_by: 100 }}{% else %}null{% endif %},"a":{% if p.available %}1{% else %}0{% endif %},"img":{{ p.featured_image | image_url: width: 600 | json }},"type":{{ p.type | json }},"tags":{{ p.tags | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}];
</script>
<script src="{{ 'choli-catalog.js' | asset_url }}" defer></script>
{% schema %}
{ "name": "Catálogo colección",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Catálogo La Choli" },
    { "type": "range", "id": "per_page", "label": "Productos por página", "min": 12, "max": 48, "step": 12, "default": 24 },
    { "type": "select", "id": "filter_mode", "label": "Filtros automáticos desde", "options": [ { "value": "tipos", "label": "Tipos de producto" }, { "value": "etiquetas", "label": "Etiquetas" } ], "default": "tipos" },
    { "type": "text", "id": "filter_exclude", "label": "Excluir del filtro (separar por coma)", "default": "" }
  ],
  "presets": [ { "name": "Catálogo colección" } ] }
{% endschema %}
